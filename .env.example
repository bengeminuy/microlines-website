PUBLIC_SITE_URL=https://microlines.example

# Spam protection (Cloudflare Turnstile). Leave empty in dev.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead transport: console | resend | sheet
LEAD_TRANSPORT=console

# Resend (when LEAD_TRANSPORT=resend)
RESEND_API_KEY=
LEAD_TO_EMAIL=sales@microlines.example
LEAD_FROM_EMAIL=no-reply@microlines.example

# Google Apps Script webhook (when LEAD_TRANSPORT=sheet)
SHEET_WEBHOOK_URL=
