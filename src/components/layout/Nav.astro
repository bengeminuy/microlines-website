---
import { Image } from 'astro:assets';
import rollerImg from '@/assets/products/sample-roller.svg';
import romanImg from '@/assets/products/sample-roman.svg';
import bifoldImg from '@/assets/products/sample-bifold.svg';

type SubLink = {
  key: string;
  href: string;
  label: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
};

type NavLink = { href: string; label: string; bold?: boolean; menu?: 'blinds' | 'doors' };

const navLinks: NavLink[] = [
  { href: '/blinds', label: 'Window Blinds', bold: true, menu: 'blinds' },
  { href: '/folding-doors', label: 'Folding Doors', bold: true, menu: 'doors' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const blindsSubLinks: SubLink[] = [
  {
    key: 'roller',
    href: '/blinds/roller',
    label: 'Roller Blinds',
    description:
      'Sleek and versatile — pairs with blackout, dimout, sheer, or sunscreen fabrics for room-by-room control of light and privacy.',
    image: rollerImg,
    imageAlt: 'Roller blind sample',
  },
  {
    key: 'roman',
    href: '/blinds/roman',
    label: 'Roman Blinds',
    description:
      'Soft fabric folds for a tailored, residential feel. A natural fit for bedrooms, living rooms, and dressing areas.',
    image: romanImg,
    imageAlt: 'Roman blind sample',
  },
  {
    key: 'venetian',
    href: '/blinds/venetian',
    label: 'Venetian Blinds',
    description:
      'Tilt-controlled horizontal slats — fine-grained light and privacy in aluminium, timber, or faux-wood.',
  },
];

const doorsSubLinks: SubLink[] = [
  {
    key: 'bifold',
    href: '/folding-doors',
    label: 'Aluminium Bifold',
    description:
      'Slim-frame bifold systems in 2, 3, 4, and 6-panel configurations. Open up to 90% of the wall span for indoor-outdoor flow.',
    image: bifoldImg,
    imageAlt: 'Aluminium bifold door',
  },
];

const currentPath = Astro.url.pathname;
---

<nav class="dropdown-nav self-stretch" aria-label="Primary">
  <ul class="flex h-full flex-wrap items-stretch">
    {
      navLinks.map((l) => {
        const active = currentPath === l.href || currentPath.startsWith(l.href + '/');
        const hasMenu = !!l.menu;
        return (
          <li data-menu={hasMenu ? l.menu : undefined} class="flex items-center px-3">
            <a
              href={l.href}
              aria-current={active ? 'page' : undefined}
              aria-haspopup={hasMenu ? 'true' : undefined}
              class:list={[
                't-ui relative inline-block overflow-hidden py-2 align-middle transition-colors',
                'after:pointer-events-none after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:bg-[var(--color-brand)]',
                'after:transition-transform after:duration-300 after:ease-out motion-reduce:after:transition-none',
                l.bold && 'font-bold!',
                active
                  ? 'text-[var(--color-ink)] after:translate-y-0'
                  : 'text-[var(--color-muted)] after:translate-y-3 hover:text-[var(--color-ink)] hover:after:translate-y-0 focus-visible:after:translate-y-0',
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })
    }
  </ul>

  <div
    class="dropdown-panel absolute inset-x-0 top-full border-t border-[var(--color-border)] bg-[var(--color-canvas)]/95 shadow-lg backdrop-blur"
  >
    <div class="dropdown-section" data-content="blinds">
      <div class="container-page py-8">
        <div class="grid grid-cols-2">
          <ul>
            {
              blindsSubLinks.map((s) => (
                <li data-preview={s.key}>
                  <a
                    href={s.href}
                    class="t-ui block rounded-md py-3 pr-8 pl-4 font-semibold text-[var(--color-muted)] transition-colors hover:bg-[var(--color-surface)] hover:text-[var(--color-ink)]"
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="preview-stack pl-8">
            {
              blindsSubLinks.map((s) => (
                <div class="preview-card" data-preview-target={s.key}>
                  {s.image ? (
                    <Image
                      src={s.image}
                      alt={s.imageAlt!}
                      class="aspect-[4/3] w-full rounded-md bg-[var(--color-surface)] object-cover"
                    />
                  ) : (
                    <div class="aspect-[4/3] w-full rounded-md bg-[var(--color-surface)]" />
                  )}
                  <h3 class="t-h3 mt-4 text-[var(--color-ink)]">{s.label}</h3>
                  <p class="t-body-sm mt-2 text-[var(--color-muted)]">{s.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="dropdown-section" data-content="doors">
      <div class="container-page py-8">
        <div class="grid grid-cols-2">
          <ul>
            {
              doorsSubLinks.map((s) => (
                <li data-preview={s.key}>
                  <a
                    href={s.href}
                    class="t-ui block rounded-md py-3 pr-8 pl-4 font-semibold text-[var(--color-muted)] transition-colors hover:bg-[var(--color-surface)] hover:text-[var(--color-ink)]"
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="preview-stack pl-8">
            {
              doorsSubLinks.map((s) => (
                <div class="preview-card" data-preview-target={s.key}>
                  {s.image ? (
                    <Image
                      src={s.image}
                      alt={s.imageAlt!}
                      class="aspect-[4/3] w-full rounded-md bg-[var(--color-surface)] object-cover"
                    />
                  ) : (
                    <div class="aspect-[4/3] w-full rounded-md bg-[var(--color-surface)]" />
                  )}
                  <h3 class="t-h3 mt-4 text-[var(--color-ink)]">{s.label}</h3>
                  <p class="t-body-sm mt-2 text-[var(--color-muted)]">{s.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .dropdown-panel {
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease-out 100ms;
  }
  .dropdown-nav:has(li[data-menu]:hover) .dropdown-panel,
  .dropdown-panel:hover {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0s;
  }

  .dropdown-panel {
    display: grid;
    grid-template-areas: 'stack';
  }
  .dropdown-section {
    grid-area: stack;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      visibility 0s linear 300ms,
      opacity 200ms ease-out 100ms;
  }

  .dropdown-nav:has(li[data-menu='blinds']:hover) .dropdown-section[data-content='blinds'],
  .dropdown-section[data-content='blinds']:hover {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0s;
  }
  .dropdown-nav:has(li[data-menu='doors']:hover) .dropdown-section[data-content='doors'],
  .dropdown-section[data-content='doors']:hover {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0s;
  }

  /* When the other trigger is hovered, snap this section out instantly (no cross-fade) */
  .dropdown-nav:has(li[data-menu='doors']:hover) .dropdown-section[data-content='blinds'],
  .dropdown-nav:has(li[data-menu='blinds']:hover) .dropdown-section[data-content='doors'] {
    visibility: hidden;
    opacity: 0;
    transition: opacity 0s;
  }

  /* Preview stack inside each section */
  .preview-stack {
    display: grid;
    grid-template-areas: 'preview';
  }
  .preview-card {
    grid-area: preview;
    opacity: 0;
    visibility: hidden;
  }
  /* Default: first preview visible */
  .preview-stack > .preview-card:first-child {
    opacity: 1;
    visibility: visible;
  }
  /* When any list item is hovered, hide the default first child */
  .dropdown-section:has(li[data-preview]:hover) .preview-card {
    opacity: 0;
    visibility: hidden;
  }
  /* Show the preview matching the hovered list item */
  .dropdown-section:has(li[data-preview='roller']:hover) .preview-card[data-preview-target='roller'],
  .dropdown-section:has(li[data-preview='roman']:hover) .preview-card[data-preview-target='roman'],
  .dropdown-section:has(li[data-preview='venetian']:hover) .preview-card[data-preview-target='venetian'],
  .dropdown-section:has(li[data-preview='bifold']:hover) .preview-card[data-preview-target='bifold'] {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel,
    .dropdown-section {
      transition: none;
    }
  }
</style>
