---
import Button from '@components/ui/Button.astro';
---

<section class="container-page py-16">
  <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-10 text-center md:p-16">
    <h2 class="t-h1">Free on-site measure and quote</h2>
    <p class="t-body prose-measure mx-auto mt-3">
      Tell us about your space and we'll come to you. No obligation.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <Button href="/quote" variant="brandFill">Request a quote</Button>
      <Button href="/contact" variant="outline">Or contact us</Button>
    </div>
  </div>
</section>
