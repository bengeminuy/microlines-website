---
import { Image } from 'astro:assets';
import Button from '@components/ui/Button.astro';
import { imageSizes } from '@lib/images';
import type { GalleryEntry } from '@lib/content/queries';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: GalleryEntry[];
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  items,
  ctaHref = '/gallery',
  ctaLabel = 'Browse the full gallery',
} = Astro.props as Props;
---

{items.length > 0 && (
  <section class="container-page py-16">
    <header class="mb-8 flex flex-col items-start gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        {eyebrow && <p class="t-label-brand mb-3">{eyebrow}</p>}
        <h2 class="t-h1">{title}</h2>
        {description && <p class="t-body prose-measure mt-2">{description}</p>}
      </div>

      <div class="pw-controls hidden md:flex" data-pw-controls>
        <button type="button" class="pw-control" aria-label="Previous projects" data-pw-prev>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="pw-control" aria-label="Next projects" data-pw-next>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </header>

    <div class="pw-viewport" data-pw-viewport>
      {items.map((g) => (
        <figure class="pw-slide">
          <div class="pw-image-wrap">
            <Image
              src={g.data.afterImage}
              alt={g.data.afterAlt}
              widths={imageSizes.gallery.widths.slice()}
              sizes={imageSizes.gallery.sizes}
              class="pw-image"
            />
          </div>
          <figcaption class="mt-3">
            <p class="t-h3">{g.data.title}</p>
            {g.data.caption && <p class="t-caption mt-1">{g.data.caption}</p>}
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <Button href={ctaHref} variant="inkFill">{ctaLabel}</Button>
    </div>
  </section>
)}

<style>
  .pw-controls {
    display: flex;
    gap: 0.5rem;
  }

  .pw-control {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-canvas);
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, opacity 180ms ease;
  }

  .pw-control:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
  }

  .pw-control[aria-disabled='true'] {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  .pw-viewport {
    display: flex;
    gap: var(--space-6, 1.5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }

  .pw-viewport::-webkit-scrollbar {
    display: none;
  }

  .pw-slide {
    flex: 0 0 auto;
    width: 280px;
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .pw-slide {
      width: 360px;
    }
  }

  .pw-image-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .pw-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-viewport {
      scroll-behavior: auto;
    }
    .pw-control {
      transition: none;
    }
  }
</style>

<script>
  const sections = document.querySelectorAll<HTMLElement>('[data-pw-viewport]');
  sections.forEach((viewport) => {
    const header = viewport.previousElementSibling;
    const controls = header?.querySelector<HTMLElement>('[data-pw-controls]');
    if (!controls) return;
    const prev = controls.querySelector<HTMLButtonElement>('[data-pw-prev]');
    const next = controls.querySelector<HTMLButtonElement>('[data-pw-next]');
    if (!prev || !next) return;

    const step = () => {
      const first = viewport.querySelector<HTMLElement>('.pw-slide');
      if (!first) return viewport.clientWidth;
      const gap = parseFloat(getComputedStyle(viewport).columnGap || '0');
      return first.getBoundingClientRect().width + gap;
    };

    const updateDisabled = () => {
      const max = viewport.scrollWidth - viewport.clientWidth - 1;
      prev.setAttribute('aria-disabled', viewport.scrollLeft <= 1 ? 'true' : 'false');
      next.setAttribute('aria-disabled', viewport.scrollLeft >= max ? 'true' : 'false');
    };

    prev.addEventListener('click', () => viewport.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => viewport.scrollBy({ left: step(), behavior: 'smooth' }));
    viewport.addEventListener('scroll', updateDisabled, { passive: true });
    window.addEventListener('resize', updateDisabled);
    updateDisabled();
  });
</script>
