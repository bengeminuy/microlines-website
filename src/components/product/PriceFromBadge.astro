---
interface Props {
  amount: number;
  currency?: string;
}

const { amount, currency = 'PHP' } = Astro.props as Props;
const formatter = new Intl.NumberFormat('en-PH', { style: 'currency', currency, maximumFractionDigits: 0 });
const formatted = formatter.format(amount);
---

<span class="t-body-sm inline-flex items-baseline gap-1.5">
  <span class="t-label">From</span>
  <span class="font-medium text-[var(--color-ink)]">{formatted}</span>
</span>
