---
import type { CollectionEntry } from 'astro:content';

interface Props {
  fabrics: CollectionEntry<'fabrics'>[];
}

const { fabrics } = Astro.props as Props;
---

{fabrics.length > 0 && (
  <div>
    <p class="t-label mb-3">Available fabrics</p>
    <ul class="flex flex-wrap gap-3" role="list">
      {fabrics.map((f) => (
        <li class="t-body-sm inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-canvas)] py-1 pl-1 pr-3">
          <span
            class="inline-block h-6 w-6 rounded-full border border-[var(--color-border)]"
            style={`background-color: ${f.data.colorHex}`}
            aria-hidden="true"
          />
          <span class="text-[var(--color-ink)]">{f.data.name}</span>
          <span class="text-[var(--color-muted)]">· {f.data.opacity}</span>
        </li>
      ))}
    </ul>
  </div>
)}
