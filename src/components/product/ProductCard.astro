---
import { Image } from 'astro:assets';
import Card from '@components/ui/Card.astro';
import PriceFromBadge from './PriceFromBadge.astro';
import { imageSizes } from '@lib/images';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  heroImage: ImageMetadata;
  heroAlt: string;
  priceFrom: number;
  currency?: string;
}

const { href, title, excerpt, heroImage, heroAlt, priceFrom, currency } = Astro.props as Props;
---

<Card href={href} class="group">
  <div class="aspect-[4/3] overflow-hidden bg-[var(--color-surface)]">
    <Image
      src={heroImage}
      alt={heroAlt}
      widths={imageSizes.productCard.widths.slice()}
      sizes={imageSizes.productCard.sizes}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="space-y-2 p-5">
    <h3 class="t-h3">{title}</h3>
    <p class="t-body-sm">{excerpt}</p>
    <PriceFromBadge amount={priceFrom} currency={currency} />
  </div>
</Card>
