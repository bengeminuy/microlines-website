---
import Field from './Field.astro';

interface Props {
  preselectProduct?: string;
  errors?: Record<string, string>;
  values?: Record<string, string>;
  succeeded?: boolean;
}

const { preselectProduct, errors = {}, values = {}, succeeded = false } = Astro.props as Props;

const productOptions = [
  { value: 'roller-blinds', label: 'Roller blinds' },
  { value: 'roman-blinds', label: 'Roman blinds' },
  { value: 'venetian-blinds', label: 'Venetian blinds' },
  { value: 'folding-doors', label: 'Folding doors' },
  { value: 'other', label: 'Other' },
  { value: 'not-sure', label: "I'm not sure yet" },
];

const selectedProduct = values.productInterest ?? preselectProduct ?? 'not-sure';
const selectedContact = values.preferredContact ?? 'either';
---

{succeeded ? (
  <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
    <h2 class="t-h2">Thanks — we got your request.</h2>
    <p class="t-body-sm mt-2">
      A team member will be in touch within one business day to schedule your free on-site measure.
    </p>
  </div>
) : (
  <form method="post" action="/api/quote" class="grid gap-4" novalidate>
    <input type="hidden" name="startedAt" value={Date.now()} />
    <div class="hidden" aria-hidden="true">
      <label>
        Company (leave blank)
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <Field name="name" label="Your name" required errors={errors} values={values} autocomplete="name" />
      <Field name="email" type="email" label="Email" required errors={errors} values={values} autocomplete="email" />
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <Field name="phone" type="tel" label="Phone" errors={errors} values={values} autocomplete="tel" />
      <Field name="postcode" label="Postcode / area" errors={errors} values={values} autocomplete="postal-code" />
    </div>

    <label class="grid gap-1.5">
      <span class="t-ui">Product interest</span>
      <select
        name="productInterest"
        class="t-body-sm rounded-md border border-[var(--color-border)] bg-[var(--color-canvas)] px-3 py-2 text-[var(--color-ink)]"
      >
        {productOptions.map((opt) => (
          <option value={opt.value} selected={selectedProduct === opt.value}>{opt.label}</option>
        ))}
      </select>
    </label>

    <fieldset class="grid gap-2">
      <legend class="t-ui">Preferred contact</legend>
      <div class="t-body-sm flex flex-wrap gap-4">
        {['email', 'phone', 'either'].map((v) => (
          <label class="inline-flex items-center gap-2">
            <input type="radio" name="preferredContact" value={v} checked={selectedContact === v} />
            <span class="capitalize">{v}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <label class="grid gap-1.5">
      <span class="t-ui">Message <span class="text-[var(--color-muted)]">(optional)</span></span>
      <textarea
        name="message"
        rows="4"
        class="t-body-sm rounded-md border border-[var(--color-border)] bg-[var(--color-canvas)] px-3 py-2 text-[var(--color-ink)]"
      >{values.message ?? ''}</textarea>
    </label>

    {errors._form && <p role="alert" class="t-body-sm rounded-md bg-[var(--color-brand-50)] px-3 py-2 text-[var(--color-brand)]">{errors._form}</p>}

    <button
      type="submit"
      class="t-button mt-2 inline-flex items-center justify-center rounded-md bg-[var(--color-brand)] px-5 py-3 text-[var(--color-canvas)] transition-colors hover:bg-[var(--color-brand-900)]"
    >
      Request a quote
    </button>
  </form>
)}
