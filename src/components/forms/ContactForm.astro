---
import Field from './Field.astro';

interface Props {
  errors?: Record<string, string>;
  values?: Record<string, string>;
  succeeded?: boolean;
}

const { errors = {}, values = {}, succeeded = false } = Astro.props as Props;
const selectedTopic = values.topic ?? 'general';
const topics = [
  { value: 'general', label: 'General enquiry' },
  { value: 'showroom', label: 'Visit our office' },
  { value: 'support', label: 'Support / existing order' },
  { value: 'press', label: 'Press / partnership' },
  { value: 'other', label: 'Other' },
];
---

{succeeded ? (
  <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
    <h2 class="t-h2">Message received.</h2>
    <p class="t-body-sm mt-2">We'll reply within one business day.</p>
  </div>
) : (
  <form method="post" action="/api/lead" class="grid gap-4" novalidate>
    <input type="hidden" name="startedAt" value={Date.now()} />
    <div class="hidden" aria-hidden="true">
      <label>
        Company (leave blank)
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <Field name="name" label="Your name" required errors={errors} values={values} autocomplete="name" />
      <Field name="email" type="email" label="Email" required errors={errors} values={values} autocomplete="email" />
    </div>
    <Field name="phone" type="tel" label="Phone (optional)" errors={errors} values={values} autocomplete="tel" />

    <label class="grid gap-1.5">
      <span class="t-ui">Topic</span>
      <select
        name="topic"
        class="t-body-sm rounded-md border border-[var(--color-border)] bg-[var(--color-canvas)] px-3 py-2 text-[var(--color-ink)]"
      >
        {topics.map((t) => (
          <option value={t.value} selected={selectedTopic === t.value}>{t.label}</option>
        ))}
      </select>
    </label>

    <label class="grid gap-1.5">
      <span class="t-ui">Message <span aria-hidden="true" class="text-[var(--color-brand)]">*</span></span>
      <textarea
        name="message"
        rows="5"
        required
        class="t-body-sm rounded-md border border-[var(--color-border)] bg-[var(--color-canvas)] px-3 py-2 text-[var(--color-ink)]"
      >{values.message ?? ''}</textarea>
      {errors.message && <span class="t-caption text-[var(--color-brand)]">{errors.message}</span>}
    </label>

    {errors._form && <p role="alert" class="t-body-sm rounded-md bg-[var(--color-brand-50)] px-3 py-2 text-[var(--color-brand)]">{errors._form}</p>}

    <button
      type="submit"
      class="t-button mt-2 inline-flex items-center justify-center rounded-md bg-[var(--color-brand)] px-5 py-3 text-[var(--color-canvas)] transition-colors hover:bg-[var(--color-brand-900)]"
    >
      Send message
    </button>
  </form>
)}
