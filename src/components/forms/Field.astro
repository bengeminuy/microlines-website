---
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'url' | 'number';
  required?: boolean;
  autocomplete?: string;
  values?: Record<string, string>;
  errors?: Record<string, string>;
  placeholder?: string;
}

const {
  name,
  label,
  type = 'text',
  required = false,
  autocomplete,
  values = {},
  errors = {},
  placeholder,
} = Astro.props as Props;

const value = values[name] ?? '';
const error = errors[name];
const id = `field-${name}`;
---

<label for={id} class="field" data-error={error ? '' : undefined}>
  <span class="field__label t-label">
    {label}{required && <span aria-hidden="true" class="text-[var(--color-brand)]"> *</span>}
  </span>
  <input
    id={id}
    name={name}
    type={type}
    required={required}
    autocomplete={autocomplete}
    placeholder={placeholder}
    value={value}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={error ? `${id}-error` : undefined}
    class="field__input"
  />
  {error && <span id={`${id}-error`} class="field__error t-caption text-[var(--color-brand)]">{error}</span>}
</label>
